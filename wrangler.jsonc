{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baroquote-hub",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "quote.info-myview.co.kr",
      "custom_domain": true
    }
  ]
}
