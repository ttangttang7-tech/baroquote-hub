---
import type { EstimateResult, PriceEvidence, SourceType, VerificationStatus } from '../lib/registry/types';

interface PriceEvidenceDetails extends Partial<PriceEvidence> {
  sourceName?: string;
  sourceType?: SourceType;
  conditions?: string;
  verifiedAt?: string;
  verified?: boolean;
  provider?: string;
  notes?: string;
  lastVerifiedAt?: string;
  reliabilityLevel?: 'high' | 'medium' | 'low';
  verificationStatus?: VerificationStatus;
}

interface Props {
  initialResult: EstimateResult;
  priceEvidence: PriceEvidenceDetails;
}

const { initialResult, priceEvidence } = Astro.props;

const sourceName = priceEvidence.sourceName || priceEvidence.provider || '표준 시장 요금표';
const conditions = priceEvidence.conditions || priceEvidence.notes || '표준 작업 기준';
const verifiedAt = priceEvidence.verifiedAt || priceEvidence.lastVerifiedAt || '2026-10-01';
const isVerified = priceEvidence.verificationStatus === 'verified' || (priceEvidence.verified === true && priceEvidence.verificationStatus !== 'unverified');
const verificationStatusText = priceEvidence.verificationStatus === 'verified'
  ? '정기 검증 완료'
  : priceEvidence.verificationStatus === 'partially_verified'
  ? '부분 검증'
  : priceEvidence.verificationStatus === 'stale'
  ? '검증 기한 만료'
  : '검증 대기';

const sourceTypeLabel = priceEvidence.sourceType === 'official_standard'
  ? '정부·공공 표준고시가'
  : priceEvidence.sourceType === 'platform_average'
  ? '플랫폼 실거래 시세 빅데이터'
  : priceEvidence.sourceType === 'market_survey'
  ? '시장 표본 설문조사'
  : priceEvidence.sourceType === 'regulatory_guideline'
  ? '관련 법령 및 행정 가이드라인'
  : '참고 시세 데이터';

const formatMoney = (val: number) => {
  return val.toLocaleString('ko-KR');
};

const formatManwon = (val: number) => {
  return `${(val / 10000).toLocaleString('ko-KR')}만`;
};
---

<div class="estimate-result-card" id="estimateResultContainer" aria-live="polite">
  <div class="result-header">
    <div class="result-status-badge">
      {initialResult.type === 'range_estimate' ? (
        <span class="badge badge-verified" id="resultTypeBadge">예상 견적 정상 산출</span>
      ) : (
        <span class="badge badge-warning" id="resultTypeBadge">현장 진단 및 준비 가이드</span>
      )}
    </div>
    <div class="result-date" id="resultDate">
      기준일: {initialResult.verificationDate}
    </div>
  </div>

  <!-- Primary Price or Prep Display: Both elements rendered in DOM to guarantee clean client transitions -->
  <div class="result-highlight-box">
    <div
      class="range-display"
      id="rangeDisplay"
      style={initialResult.type === 'range_estimate' && initialResult.minAmount && initialResult.maxAmount ? '' : 'display: none;'}
    >
      <div class="range-label">시장 실거래 빅데이터 기반 예상 범위</div>
      <div class="range-amounts">
        <span class="amount-val" id="minAmountDisplay">{initialResult.minAmount ? formatMoney(initialResult.minAmount) : ''}</span>
        <span class="amount-sep">~</span>
        <span class="amount-val" id="maxAmountDisplay">{initialResult.maxAmount ? formatMoney(initialResult.maxAmount) : ''}</span>
        <span class="amount-unit">원</span>
      </div>
      <div class="range-subtext" id="manwonDisplay">
        {initialResult.minAmount && initialResult.maxAmount ? `(약 ${formatManwon(initialResult.minAmount)}원 ~ ${formatManwon(initialResult.maxAmount)}원)` : ''}
      </div>
      <div class="range-notice" id="rangeNotice">
        ※ 본 금액은 시공 업체의 확정 견적이 아닌 시장 통계 기반 참고용 추정 범위이며, 현장 조건에 따라 달라질 수 있습니다.
      </div>
    </div>

    <div
      class="prep-display"
      id="prepDisplay"
      style={initialResult.type === 'range_estimate' && initialResult.minAmount && initialResult.maxAmount ? 'display: none;' : ''}
    >
      <div class="prep-icon-wrap" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </div>
      <div class="prep-title" id="prepTitle">
        {initialResult.prepTitle || '현장 방문 실측 맞춤 견적 권장 서비스'}
      </div>
      <div class="prep-desc" id="prepDesc">
        {initialResult.basis.explanation || '본 서비스는 현장 상태, 시공 범위, 자재 스펙에 따라 편차가 커 단일 정액가 대신 현장 실측 맞춤 견적을 권장합니다. 아래 점검 항목을 바탕으로 2~3개 업체의 견적서를 비교하세요.'}
      </div>
    </div>
  </div>

  <!-- Cost Breakdown / Basis -->
  <div class="result-section">
    <h3 class="section-title">
      {initialResult.type === 'range_estimate' ? '금액 산정 세부 내역' : '비용 결정 핵심 요인'}
    </h3>
    <ul class="breakdown-list" id="breakdownList">
      {initialResult.basis.breakdown.map((item) => (
        <li class="breakdown-item">
          <span class="item-label">{item.label}</span>
          <span class="item-amount">
            {typeof item.amount === 'number' ? (
              item.amount === 0 ? (initialResult.type === 'range_estimate' ? '기본 포함' : '핵심 요인') : `+${formatMoney(item.amount)}원`
            ) : (
              item.amount
            )}
          </span>
        </li>
      ))}
    </ul>
    <p class="basis-note" id="basisNote">{initialResult.basis.explanation}</p>
  </div>

  <!-- Included & Excluded Items Grid -->
  <div class="items-grid">
    <div class="item-col col-included">
      <h4 class="col-title text-success">
        <span>기본 포함 항목</span>
      </h4>
      <ul class="chip-list" id="includedList">
        {initialResult.includedItems.map((item) => (
          <li class="chip chip-inc">✓ {item}</li>
        ))}
      </ul>
    </div>

    <div class="item-col col-excluded">
      <h4 class="col-title text-danger">
        <span>별도 / 추가 청구 항목</span>
      </h4>
      <ul class="chip-list" id="excludedList">
        {initialResult.excludedItems.map((item) => (
          <li class="chip chip-exc">✕ {item}</li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Surcharge Warnings -->
  {initialResult.surchargeWarnings.length > 0 && (
    <div class="result-section surcharge-section" id="surchargeSection">
      <h3 class="section-title text-warning">
        현장 추가요금 주의 요인 (바가지 방지)
      </h3>
      <ul class="warning-list" id="warningList">
        {initialResult.surchargeWarnings.map((warn) => (
          <li class="warning-item">{warn}</li>
        ))}
      </ul>
    </div>
  )}

  <!-- Contractor Checklist -->
  <div class="result-section checklist-section">
    <h3 class="section-title">
      업체 문의 시 필수 확인 체크리스트
    </h3>
    <ul class="checklist-items" id="checklistItems">
      {initialResult.checklist.map((item, idx) => (
        <li class="check-item">
          <label class="check-label">
            <input type="checkbox" id={`chk-${idx}`} />
            <span>{item}</span>
          </label>
        </li>
      ))}
    </ul>
  </div>

  <!-- Source Evidence & Notice -->
  <div class="evidence-box">
    <div class="evidence-header">
      <span class="evidence-title">가격 자료 출처 및 신뢰도 검증</span>
    </div>
    <div class="evidence-details">
      <p>
        <strong>공식 출처:</strong> 
        {priceEvidence.sourceUrl ? (
          <a href={priceEvidence.sourceUrl} target="_blank" rel="noopener noreferrer" class="source-link">
            {sourceName} ↗
          </a>
        ) : (
          sourceName
        )}
        <span class="badge-source">({sourceTypeLabel})</span>
      </p>
      <p><strong>적용 조건:</strong> {conditions}</p>
      <p><strong>검증 상태:</strong> <span class={`status-pill ${isVerified ? 'status-verified' : 'status-pending'}`}>{verificationStatusText}</span> (최근 검증일: {verifiedAt})</p>
      <p class="evidence-disclaimer">※ 본 견적은 시장 평균 단가 기준 참고치이며, 계약 전 반드시 해당 업체로부터 서면 확정 견적을 수령하시기 바랍니다.</p>
    </div>
  </div>

  <!-- Copy Button -->
  <div class="result-actions">
    <button type="button" class="btn btn-secondary btn-block" id="copyResultBtn">
      <span>견적 요약 결과 복사하기</span>
    </button>
    <div class="copy-alert" id="copyAlert" style="display: none;">
      ✓ 견적 요약이 클립보드에 복사되었습니다!
    </div>
  </div>
</div>

<style>
  .estimate-result-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 26px;
    box-shadow: var(--shadow-sm);
  }

  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 20px;
  }

  .result-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .result-highlight-box {
    background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
    border: 1.5px solid #99f6e4;
    border-radius: var(--radius-lg);
    padding: 24px;
    text-align: center;
    margin-bottom: 24px;
  }

  .range-label {
    font-size: 0.885rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .range-amounts {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 6px;
    font-variant-numeric: tabular-nums;
  }

  .amount-val {
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    font-weight: 850;
    color: var(--color-text-main);
  }

  .amount-sep {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .amount-unit {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .range-subtext {
    font-size: 0.9rem;
    color: var(--color-secondary);
    font-weight: 700;
    margin-top: 6px;
  }

  .range-notice {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-top: 14px;
    padding: 8px 12px;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: inline-block;
    max-width: 95%;
  }

  .prep-display {
    padding: 12px 6px;
  }

  .prep-icon-wrap {
    margin-bottom: 12px;
    display: flex;
    justify-content: center;
  }

  .prep-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .prep-desc {
    font-size: 0.9rem;
    color: var(--color-text-body);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto;
  }

  .result-section {
    margin-bottom: 24px;
  }

  .section-title {
    font-size: 1rem;
    font-weight: 750;
    margin: 0 0 12px;
    color: var(--color-text-main);
    letter-spacing: -0.01em;
  }

  .breakdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background-color: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .breakdown-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .breakdown-item:last-child {
    border-bottom: none;
  }

  .item-label {
    color: var(--color-text-body);
    font-weight: 500;
  }

  .item-amount {
    font-weight: 700;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .basis-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 8px 0 0;
    line-height: 1.5;
  }

  .items-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 24px;
  }

  .item-col {
    background-color: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 14px;
  }

  .col-title {
    font-size: 0.885rem;
    font-weight: 700;
    margin: 0 0 10px;
  }

  .text-success {
    color: var(--color-success);
  }

  .text-danger {
    color: var(--color-error);
  }

  .chip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    font-size: 0.78rem;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .chip-inc {
    background-color: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .chip-exc {
    background-color: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .surcharge-section {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: var(--radius-md);
    padding: 16px;
  }

  .text-warning {
    color: #92400e;
  }

  .warning-list {
    list-style: disc;
    margin: 0;
    padding-left: 20px;
    font-size: 0.885rem;
    color: #92400e;
    line-height: 1.6;
  }

  .checklist-section {
    background-color: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 16px;
  }

  .checklist-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .check-item {
    font-size: 0.885rem;
  }

  .check-label {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    cursor: pointer;
    line-height: 1.45;
    color: var(--color-text-body);
  }

  .check-label input {
    margin-top: 3px;
    accent-color: var(--color-primary);
    width: 16px;
    height: 16px;
  }

  .evidence-box {
    background-color: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 24px;
  }

  .evidence-header {
    margin-bottom: 8px;
  }

  .evidence-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .evidence-details p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0 0 4px;
    line-height: 1.5;
  }

  .source-link {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 600;
  }

  .source-link:hover {
    color: var(--color-primary-hover);
  }

  .badge-source {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-left: 4px;
  }

  .status-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .status-verified {
    background-color: #ecfdf5;
    color: #059669;
    border: 1px solid #a7f3d0;
  }

  .status-pending {
    background-color: #fef3c7;
    color: #d97706;
    border: 1px solid #fde68a;
  }

  .evidence-disclaimer {
    color: var(--color-text-subtle);
    margin-top: 8px !important;
  }

  .result-actions {
    position: relative;
  }

  .btn-block {
    width: 100%;
    height: 48px;
  }

  .copy-alert {
    margin-top: 8px;
    padding: 10px 14px;
    background-color: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 640px) {
    .estimate-result-card {
      padding: 18px;
    }

    .items-grid {
      grid-template-columns: 1fr;
    }

    .range-amounts {
      flex-direction: column;
      gap: 0;
    }

    .amount-sep {
      display: none;
    }
  }
</style>
