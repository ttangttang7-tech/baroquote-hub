---
interface Props {
  slotId?: string;
  format?: 'auto' | 'rectangle' | 'horizontal' | 'fluid';
  label?: string;
  class?: string;
}

const { 
  slotId = 'default-slot',
  format = 'auto',
  label = '광고',
  class: className = ''
} = Astro.props;

// AdSense Client ID (configured for production)
const adClient = 'ca-pub-0000000000000000'; // Replace with approved pub ID in production
const isProd = import.meta.env.PROD;
---

<div class:list={['ad-container', `ad-format-${format}`, className]} role="region" aria-label="스폰서 영역">
  <div class="ad-label-wrapper">
    <span class="ad-label">{label}</span>
  </div>
  <div class="ad-slot" data-slot-id={slotId}>
    {isProd ? (
      <ins 
        class="adsbygoogle"
        style="display:block; width:100%; height:100%; text-align:center;"
        data-ad-client={adClient}
        data-ad-slot={slotId}
        data-ad-format={format}
        data-full-width-responsive="true"
      ></ins>
    ) : (
      <div class="ad-placeholder">
        <span class="placeholder-icon">📢</span>
        <span class="placeholder-text">스폰서 광고 영역 ({slotId})</span>
      </div>
    )}
  </div>
</div>

<style>
  .ad-container {
    width: 100%;
    margin: var(--space-6) auto;
    text-align: center;
    overflow: hidden;
    max-width: 100%;
  }

  .ad-label-wrapper {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 2px;
    padding: 0 var(--space-2);
  }

  .ad-label {
    font-size: 11px;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .ad-slot {
    background-color: #F8FAFC;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100px;
    overflow: hidden;
    position: relative;
  }

  .ad-format-rectangle .ad-slot {
    min-height: 250px;
    max-height: 280px;
  }

  .ad-format-horizontal .ad-slot {
    min-height: 90px;
    max-height: 120px;
  }

  .ad-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    padding: var(--space-4);
  }

  .placeholder-icon {
    font-size: 18px;
    opacity: 0.6;
  }

  .placeholder-text {
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .ad-container {
      margin: var(--space-4) auto;
    }
    
    .ad-slot {
      min-height: 80px;
    }

    .ad-format-rectangle .ad-slot {
      min-height: 200px;
    }
  }
</style>
