---
import type { ServiceDefinition } from '../lib/registry/types';
import { getCategoryById } from '../lib/registry/categories';

interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
const category = getCategoryById(service.categoryId || service.category || 'cleaning');

const isRange = service.estimateType === 'range_estimate' && service.defaultMinAmount && service.defaultMaxAmount;
const formatManwon = (won: number) => `${Math.round(won / 10000)}만`;
const shortDesc = service.shortDescription || service.shortDesc;
---

<article class="service-card" data-service-id={service.id} data-category={service.categoryId || service.category}>
  <div class="card-top">
    <span class="category-pill">{category?.name}</span>
    <span class="verification-badge">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M13.333 4L6 11.333 2.667 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      시세 검증
    </span>
  </div>

  <h3 class="service-card-title">
    <a href={`/estimate/${service.slug}`} class="service-title-link">
      {service.title}
    </a>
  </h3>

  <p class="service-card-desc">
    {shortDesc}
  </p>

  <div class="price-strip">
    <span class="price-title">예상 시세</span>
    <div class="price-content">
      {isRange ? (
        <span class="price-amount">
          {formatManwon(service.defaultMinAmount!)} ~ {formatManwon(service.defaultMaxAmount!)}
          <span class="won-unit">원</span>
        </span>
      ) : (
        <span class="prep-badge">현장 맞춤 가이드</span>
      )}
    </div>
  </div>

  <div class="card-footer">
    <a href={`/estimate/${service.slug}`} class="service-btn" aria-label={`${service.title} 맞춤 견적 확인하기`}>
      <span>예상 견적 확인</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .service-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 22px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }

  .service-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: var(--radius-full);
  }

  .verification-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-success);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .service-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 8px;
    letter-spacing: -0.015em;
  }

  .service-title-link {
    color: var(--color-text-main);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .service-card:hover .service-title-link {
    color: var(--color-primary);
  }

  .service-card-desc {
    font-size: 0.885rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0 0 16px;
    flex: 1;
  }

  .price-strip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 10px 14px;
    background-color: #f8fafc;
    border-radius: var(--radius-md);
    margin-bottom: 16px;
  }

  .price-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .price-amount {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-text-main);
    font-variant-numeric: tabular-nums;
  }

  .won-unit {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-body);
    margin-left: 2px;
  }

  .prep-badge {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .service-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 11px 16px;
    background-color: var(--color-surface);
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
    border-radius: var(--radius-md);
    font-size: 0.925rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .service-card:hover .service-btn {
    background-color: var(--color-primary);
    color: #ffffff;
  }
</style>
