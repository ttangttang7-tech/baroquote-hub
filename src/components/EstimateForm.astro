---
import type { QuestionDefinition } from '../lib/registry/types';

interface Props {
  serviceId: string;
  questions: QuestionDefinition[];
  initialAnswers: Record<string, any>;
}

const { serviceId, questions, initialAnswers } = Astro.props;
---

<form class="estimate-form" id="estimateForm" data-service-id={serviceId}>
  <div class="form-header">
    <h2 class="form-title">조건 선택</h2>
    <p class="form-desc">
      조건을 선택하면 실시간 시장 예상 견적과 체크리스트가 즉시 계산됩니다.
    </p>
  </div>

  <div class="questions-container">
    {questions.map((q) => {
      const qVal = initialAnswers[q.id] ?? q.defaultValue;
      const fieldId = `field-${serviceId}-${q.id}`;

      return (
        <div class="form-group" data-question-id={q.id}>
          <label for={fieldId} class="form-label">
            <span class="label-text">{q.label}</span>
            {q.required && <span class="required-star" aria-label="필수 입력">*</span>}
          </label>

          {q.type === 'select' && (
            <div class="select-wrapper">
              <select 
                id={fieldId} 
                name={q.id} 
                class="form-select" 
                required={q.required}
              >
                {q.options?.map((opt) => (
                  <option value={opt.value} selected={String(qVal) === String(opt.value)}>
                    {opt.label}
                  </option>
                ))}
              </select>
            </div>
          )}

          {q.type === 'number' && (
            <div class="number-input-group">
              <input
                type="number"
                id={fieldId}
                name={q.id}
                class="form-input form-number"
                value={qVal}
                min={q.min}
                max={q.max}
                step={q.step || 1}
                required={q.required}
              />
              {q.unit && <span class="input-unit">{q.unit}</span>}
            </div>
          )}

          {q.type === 'radio' && (
            <div class="radio-group" role="radiogroup" aria-label={q.label}>
              {q.options?.map((opt, oIdx) => (
                <label class="radio-label">
                  <input
                    type="radio"
                    name={q.id}
                    value={opt.value}
                    checked={String(qVal) === String(opt.value)}
                    id={`${fieldId}-${oIdx}`}
                  />
                  <span class="option-text">{opt.label}</span>
                </label>
              ))}
            </div>
          )}

          {q.type === 'checkbox' && (
            <div class="checkbox-group">
              {q.options?.map((opt, oIdx) => {
                const isChecked = Array.isArray(qVal) ? qVal.includes(opt.value) : false;
                return (
                  <label class="checkbox-label">
                    <input
                      type="checkbox"
                      name={q.id}
                      value={opt.value}
                      checked={isChecked}
                      id={`${fieldId}-${oIdx}`}
                    />
                    <span class="option-text">{opt.label}</span>
                  </label>
                );
              })}
            </div>
          )}

          {q.type === 'boolean' && (
            <label class="boolean-toggle-label">
              <input
                type="checkbox"
                id={fieldId}
                name={q.id}
                value="true"
                checked={Boolean(qVal)}
              />
              <span class="toggle-text">{q.label} 적용</span>
            </label>
          )}

          {q.helpText && (
            <div class="form-helper">{q.helpText}</div>
          )}
        </div>
      );
    })}
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary btn-submit" id="calculateBtn">
      예상 견적 확인하기
    </button>
    <button type="button" class="btn btn-secondary btn-reset" id="resetBtn">
      초기화
    </button>
  </div>

  <div class="form-safety-note">
    <span class="lock-icon" aria-hidden="true">🔒</span>
    <span>개인정보(전화번호·주소) 입력 없이 브라우저에서 안전하게 실시간 계산됩니다.</span>
  </div>
</form>

<style>
  .estimate-form {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 26px;
    box-shadow: var(--shadow-sm);
  }

  .form-header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .form-title {
    font-size: 1.25rem;
    font-weight: 750;
    margin: 0 0 6px;
    color: var(--color-text-main);
    letter-spacing: -0.015em;
  }

  .form-desc {
    font-size: 0.885rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .questions-container {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.925rem;
    font-weight: 650;
    color: var(--color-text-main);
  }

  .required-star {
    color: var(--color-error);
    font-weight: bold;
  }

  .select-wrapper {
    position: relative;
  }

  .number-input-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .form-number {
    max-width: 160px;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .input-unit {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .radio-group,
  .checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .radio-label,
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    min-height: 44px;
    background-color: #f8fafc;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-body);
    transition: all 0.15s ease;
    user-select: none;
  }

  .radio-label:hover,
  .checkbox-label:hover {
    border-color: var(--color-primary);
    background-color: var(--color-primary-light);
  }

  .radio-label:has(input:checked),
  .checkbox-label:has(input:checked) {
    border-color: var(--color-primary);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
  }

  .radio-label input,
  .checkbox-label input {
    accent-color: var(--color-primary);
    width: 16px;
    height: 16px;
  }

  .boolean-toggle-label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 10px 14px;
    background-color: #f8fafc;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all 0.15s ease;
  }

  .boolean-toggle-label:hover {
    border-color: var(--color-primary);
    background-color: var(--color-primary-light);
  }

  .boolean-toggle-label input {
    accent-color: var(--color-primary);
    width: 18px;
    height: 18px;
  }

  .form-helper {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .form-actions {
    display: flex;
    gap: 10px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  .btn-submit {
    flex: 3;
    height: 50px;
    font-size: 1.02rem;
  }

  .btn-reset {
    flex: 1;
    height: 50px;
  }

  .form-safety-note {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background-color: #f8fafc;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    line-height: 1.45;
  }

  .lock-icon {
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .estimate-form {
      padding: 18px;
    }

    .form-actions {
      flex-direction: column;
    }
  }
</style>
