---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EstimateForm from '../../components/EstimateForm.astro';
import EstimateResultComponent from '../../components/EstimateResult.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SERVICES } from '../../lib/registry';
import { getCategoryById } from '../../lib/registry/categories';
import { calculateEstimate } from '../../lib/engine/estimator';

export async function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const categoryId = service.categoryId || service.category || 'cleaning';
const category = getCategoryById(categoryId);
const faqs = service.faqs || service.seo?.faq || [];
const shortDesc = service.shortDescription || service.shortDesc;
const evidenceData = service.priceEvidence || service.evidence;
const verifiedDate = service.priceEvidence?.verifiedAt || service.evidence?.lastVerifiedAt || '2026-10-01';

// Compute initial default answers
const initialAnswers: Record<string, any> = {};
for (const q of service.questions) {
  initialAnswers[q.id] = q.defaultValue;
}

// Compute initial static estimate for instant SSG rendering
const initialResult = calculateEstimate(service.id, initialAnswers);

// Related services (prefer explicitly defined relatedServiceIds, fallback to same category)
const relatedServiceIds = service.relatedServiceIds || [];
const relatedServices = SERVICES.filter(s => 
  s.id !== service.id && 
  (relatedServiceIds.includes(s.id) || (s.categoryId || s.category) === categoryId)
).slice(0, 3);

// Breadcrumb
const breadcrumbItems = [
  { name: category?.name || '카테고리', url: `/category/${categoryId}` },
  { name: service.title }
];

// JSON-LD Structured Data: WebApplication (Information Tool) & FAQPage
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": `${service.title} 견적 계산기`,
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "All",
    "description": service.seo.description,
    "url": `https://quote.info-myview.co.kr/estimate/${service.slug}`,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "KRW"
    },
    "browserRequirements": "Requires JavaScript. Requires HTML5."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }
];
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  canonicalPath={`/estimate/${service.slug}`}
  currentCategory={categoryId}
  jsonLd={jsonLd}
>
  <div class="container service-page">
    <Breadcrumb items={breadcrumbItems} />

    <!-- Service Header -->
    <header class="service-header">
      <div class="service-meta-top">
        <a href={`/category/${categoryId}`} class="category-pill-link">
          <span aria-hidden="true">{category?.icon}</span>
          <span>{category?.name}</span>
        </a>
        <span class="service-badge-id">No. {service.number || service.id}</span>
        <span class="verification-badge">
          기준일: {verifiedDate} ({evidenceData?.verificationStatus === 'verified' ? '정기 검증완료' : '참고시세'})
        </span>
      </div>

      <h1 class="service-title">{service.title}</h1>
      <p class="service-intro">{shortDesc}</p>
    </header>

    <!-- Top Ad Slot -->
    <AdSlot slotId={`estimate-${service.slug}-top`} format="horizontal" />

    <!-- Interactive Estimate Workspace (2 Columns on Desktop) -->
    <section class="estimate-workspace">
      <div class="workspace-grid">
        <!-- Left Column: Form -->
        <div class="form-column">
          <EstimateForm 
            serviceId={service.id} 
            questions={service.questions} 
            initialAnswers={initialAnswers} 
          />
        </div>

        <!-- Right Column: Result -->
        <div class="result-column">
          <EstimateResultComponent 
            initialResult={initialResult} 
            priceEvidence={evidenceData} 
          />
        </div>
      </div>
    </section>

    <!-- Mid Ad Slot -->
    <AdSlot slotId={`estimate-${service.slug}-mid`} format="rectangle" />

    <!-- FAQ Section (4+ FAQs) -->
    <section class="faq-section">
      <div class="section-header-left">
        <span class="faq-badge">자주 묻는 질문</span>
        <h2 class="section-title">{service.title} 관련 필수 안내</h2>
        <p class="section-subtitle">현장에서 가장 많이 발생하는 추가비용과 주의사항을 모았습니다.</p>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <span class="faq-q-mark">Q</span>
              <span class="faq-q-text">{faq.question}</span>
              <span class="faq-toggle-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Safety & Disclaimer Banner -->
    <section class="safety-banner">
      <div class="banner-icon">💡</div>
      <div class="banner-content">
        <h3 class="banner-title">시공 전 계약 및 안전 수칙</h3>
        <p class="banner-desc">
          시공 중 발생하는 추가 공사비 분쟁을 방지하기 위해 반드시 <strong>작업 범위와 추가요금 조건이 명시된 서면 견적서</strong>를 수령하세요. 가스, 고압 전기, 보일러 배관 등은 안전사고 위험이 있으므로 자격증을 보유한 전문 시공사에 의뢰하시기 바랍니다.
        </p>
      </div>
    </section>

    <!-- Related Services -->
    {relatedServices.length > 0 && (
      <section class="related-services-section">
        <h2 class="section-title">함께 많이 비교하는 추천 서비스</h2>
        <div class="services-grid">
          {relatedServices.map(rel => (
            <ServiceCard service={rel} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .service-page {
    padding: 24px 16px 64px;
  }

  .service-header {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 28px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }

  .service-meta-top {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .category-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .category-pill-link:hover {
    background-color: #ccfbf1;
  }

  .service-badge-id {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    background-color: #f1f5f9;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .verification-badge {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .service-title {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 800;
    color: var(--color-text-main);
    margin: 0 0 10px;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .service-intro {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 820px;
  }

  .estimate-workspace {
    margin: 32px 0;
  }

  .workspace-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: start;
  }

  .section-header-left {
    margin-bottom: 24px;
  }

  .faq-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 8px;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin: 0 0 6px;
    letter-spacing: -0.015em;
  }

  .section-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .faq-section {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 28px;
    margin: 36px 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: #f8fafc;
    overflow: hidden;
    transition: all 0.15s ease;
  }

  .faq-item[open] {
    border-color: var(--color-primary);
    background-color: #ffffff;
  }

  .faq-question {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.975rem;
    list-style: none;
    user-select: none;
    gap: 12px;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-q-mark {
    color: var(--color-primary);
    font-weight: 900;
    font-size: 1.1rem;
    background-color: var(--color-primary-light);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .faq-q-text {
    flex: 1;
    color: var(--color-text-main);
  }

  .faq-toggle-icon {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    transition: transform 0.15s ease;
  }

  .faq-item[open] .faq-toggle-icon {
    transform: rotate(45deg);
    color: var(--color-primary);
  }

  .faq-answer {
    padding: 0 20px 20px 60px;
    font-size: 0.9rem;
    color: var(--color-text-body);
    line-height: 1.65;
  }

  .faq-answer p {
    margin: 0;
  }

  .safety-banner {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: var(--radius-xl);
    padding: 22px;
    margin: 32px 0;
  }

  .banner-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .banner-title {
    font-size: 1rem;
    font-weight: 750;
    color: #92400e;
    margin: 0 0 6px;
  }

  .banner-desc {
    font-size: 0.85rem;
    color: #78350f;
    line-height: 1.6;
    margin: 0;
  }

  .related-services-section {
    margin-top: 40px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  @media (max-width: 900px) {
    .workspace-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .service-header {
      padding: 20px;
    }

    .faq-section {
      padding: 20px;
    }

    .faq-answer {
      padding: 0 16px 16px 16px;
    }
  }
</style>

<script>
  import { calculateEstimate } from '../../lib/engine/estimator';

  const form = document.getElementById('estimateForm') as HTMLFormElement | null;
  const resetBtn = document.getElementById('resetBtn');
  const copyBtn = document.getElementById('copyResultBtn');
  const copyAlert = document.getElementById('copyAlert');

  // DOM Elements to update in EstimateResult
  const resultTypeBadge = document.getElementById('resultTypeBadge');
  const rangeDisplay = document.getElementById('rangeDisplay');
  const prepDisplay = document.getElementById('prepDisplay');
  const minAmountDisplay = document.getElementById('minAmountDisplay');
  const maxAmountDisplay = document.getElementById('maxAmountDisplay');
  const manwonDisplay = document.getElementById('manwonDisplay');
  const breakdownList = document.getElementById('breakdownList');
  const basisNote = document.getElementById('basisNote');
  const includedList = document.getElementById('includedList');
  const excludedList = document.getElementById('excludedList');
  const surchargeSection = document.getElementById('surchargeSection');
  const warningList = document.getElementById('warningList');
  const checklistItems = document.getElementById('checklistItems');

  function getFormAnswers(formEl: HTMLFormElement): Record<string, any> {
    const answers: Record<string, any> = {};

    // Read unique field names
    const fieldNames = new Set<string>();
    formEl.querySelectorAll('[name]').forEach((el) => {
      const name = el.getAttribute('name');
      if (name) fieldNames.add(name);
    });

    fieldNames.forEach((name) => {
      const inputs = formEl.querySelectorAll(`[name="${name}"]`);
      if (inputs.length === 0) return;

      const firstInput = inputs[0] as HTMLInputElement;

      if (firstInput.type === 'checkbox') {
        if (inputs.length > 1) {
          // Multi-checkbox
          const checkedVals = Array.from(inputs)
            .filter((inp) => (inp as HTMLInputElement).checked)
            .map((inp) => (inp as HTMLInputElement).value);
          answers[name] = checkedVals;
        } else {
          // Boolean toggle
          answers[name] = firstInput.checked;
        }
      } else if (firstInput.type === 'radio') {
        const checked = formEl.querySelector(`[name="${name}"]:checked`) as HTMLInputElement | null;
        answers[name] = checked ? checked.value : firstInput.value;
      } else if (firstInput.type === 'number') {
        const numVal = parseFloat(firstInput.value);
        answers[name] = isNaN(numVal) ? 0 : numVal;
      } else {
        answers[name] = firstInput.value;
      }
    });

    return answers;
  }

  function formatMoney(num: number): string {
    return num.toLocaleString('ko-KR');
  }

  function formatManwon(num: number): string {
    return `${(num / 10000).toLocaleString('ko-KR')}만`;
  }

  // Active state cache
  let currentResult: any = null;

  function updateEstimateResult() {
    if (!form) return;
    const serviceId = form.getAttribute('data-service-id');
    if (!serviceId) return;

    const answers = getFormAnswers(form);
    const result = calculateEstimate(serviceId, answers);
    currentResult = result;

    // 1. Update Badge
    if (resultTypeBadge) {
      if (result.type === 'range_estimate') {
        resultTypeBadge.className = 'badge badge-verified';
        resultTypeBadge.textContent = '예상 견적 정상 산출';
      } else {
        resultTypeBadge.className = 'badge badge-warning';
        resultTypeBadge.textContent = '현장 진단 및 준비 가이드';
      }
    }

    // 2. Update Price or Prep
    if (result.type === 'range_estimate' && result.minAmount && result.maxAmount) {
      if (rangeDisplay) rangeDisplay.style.display = 'block';
      if (prepDisplay) prepDisplay.style.display = 'none';

      if (minAmountDisplay) minAmountDisplay.textContent = formatMoney(result.minAmount);
      if (maxAmountDisplay) maxAmountDisplay.textContent = formatMoney(result.maxAmount);
      if (manwonDisplay) {
        manwonDisplay.textContent = `(약 ${formatManwon(result.minAmount)}원 ~ ${formatManwon(result.maxAmount)}원)`;
      }
    } else {
      if (rangeDisplay) rangeDisplay.style.display = 'none';
      if (prepDisplay) prepDisplay.style.display = 'block';

      // Clear range amounts in DOM to prevent stale leaks and copying
      if (minAmountDisplay) minAmountDisplay.textContent = '';
      if (maxAmountDisplay) maxAmountDisplay.textContent = '';
      if (manwonDisplay) manwonDisplay.textContent = '';

      const prepTitleEl = document.getElementById('prepTitle');
      const prepDescEl = document.getElementById('prepDesc');
      if (prepTitleEl) prepTitleEl.textContent = result.prepTitle || '현장 방문 실측 맞춤 견적 권장 서비스';
      if (prepDescEl) prepDescEl.textContent = result.basis.explanation || '본 서비스는 현장 상태, 시공 범위에 따라 편차가 커 실측 맞춤 견적을 권장합니다.';
    }

    // 3. Update Breakdown
    if (breakdownList) {
      breakdownList.innerHTML = result.basis.breakdown.map((item) => {
        const amtStr = typeof item.amount === 'number'
          ? (item.amount === 0 ? (result.type === 'range_estimate' ? '기본 포함' : '핵심 요인') : `+${formatMoney(item.amount)}원`)
          : item.amount;
        return `
          <li class="breakdown-item">
            <span class="item-label">${item.label}</span>
            <span class="item-amount">${amtStr}</span>
          </li>
        `;
      }).join('');
    }

    if (basisNote) {
      basisNote.textContent = result.basis.explanation;
    }

    // 4. Update Included / Excluded
    if (includedList) {
      includedList.innerHTML = result.includedItems.map((item) => 
        `<li class="chip chip-inc">✓ ${item}</li>`
      ).join('');
    }

    if (excludedList) {
      excludedList.innerHTML = result.excludedItems.map((item) => 
        `<li class="chip chip-exc">✕ ${item}</li>`
      ).join('');
    }

    // 5. Update Surcharges
    if (surchargeSection && warningList) {
      if (result.surchargeWarnings.length > 0) {
        surchargeSection.style.display = 'block';
        warningList.innerHTML = result.surchargeWarnings.map((w) => 
          `<li class="warning-item">${w}</li>`
        ).join('');
      } else {
        surchargeSection.style.display = 'none';
      }
    }

    // 6. Update Checklist
    if (checklistItems) {
      checklistItems.innerHTML = result.checklist.map((c, i) => `
        <li class="check-item">
          <label class="check-label">
            <input type="checkbox" id="chk-live-${i}" />
            <span>${c}</span>
          </label>
        </li>
      `).join('');
    }
  }

  // Event Listeners
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      updateEstimateResult();
    });

    form.addEventListener('change', () => {
      updateEstimateResult();
    });
  }

  if (resetBtn && form) {
    resetBtn.addEventListener('click', () => {
      form.reset();
      updateEstimateResult();
    });
  }

  // Copy result to clipboard (strictly outputs guide text if preparation mode or stale)
  if (copyBtn && form) {
    copyBtn.addEventListener('click', () => {
      const serviceTitle = document.querySelector('.service-title')?.textContent?.trim() || '바로견적';
      const isRange = currentResult?.type === 'range_estimate' &&
        rangeDisplay &&
        rangeDisplay.style.display !== 'none' &&
        Boolean(minAmountDisplay?.textContent?.trim()) &&
        Boolean(maxAmountDisplay?.textContent?.trim());

      let copyText = '';
      if (isRange) {
        const minVal = minAmountDisplay?.textContent?.trim() || '';
        const maxVal = maxAmountDisplay?.textContent?.trim() || '';
        copyText = `[바로견적] ${serviceTitle} 예상견적 요약\n`;
        copyText += `▶ 예상 비용 범위: ${minVal}원 ~ ${maxVal}원 (VAT포함)\n`;
      } else {
        const prepTitleText = document.getElementById('prepTitle')?.textContent?.trim() || '현장 방문 실측 맞춤 견적 권장 서비스';
        const prepDescText = document.getElementById('prepDesc')?.textContent?.trim() || '';
        copyText = `[바로견적] ${serviceTitle} 현장 진단 및 준비 가이드\n`;
        copyText += `▶ 견적 상태: 현장 실측 및 맞춤 견적 권장 (정액 숫자 견적 미제공)\n`;
        copyText += `▶ 안내 사유: ${prepTitleText}\n`;
        if (prepDescText) {
          copyText += `▶ 상세 가이드: ${prepDescText}\n`;
        }
      }
      copyText += `▶ 산정 출처: 바로견적 (https://quote.info-myview.co.kr)\n`;
      copyText += `※ 본 견적은 시장 평균 단가 기준 참고치이며, 계약 전 반드시 해당 업체로부터 서면 확정 견적을 수령하시기 바랍니다.`;

      navigator.clipboard.writeText(copyText).then(() => {
        if (copyAlert) {
          copyAlert.style.display = 'block';
          setTimeout(() => {
            copyAlert.style.display = 'none';
          }, 3000);
        }
      });
    });
  }

  // Immediate evaluation on initial page load (prevents stale static HTML leaks across elapsed time)
  updateEstimateResult();

  // Expose test hook for verification suites
  if (typeof window !== 'undefined') {
    (window as any).__baroquote_runtime = {
      updateEstimateResult,
      getCurrentResult: () => currentResult,
      getFormAnswers: () => form ? getFormAnswers(form) : {},
    };
  }
</script>
