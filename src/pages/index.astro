---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { CATEGORIES } from '../lib/registry/categories';
import { SERVICES, getServicesByCategory } from '../lib/registry';

// Curated Editorial Recommendation (6 tools)
const recommendedSlugs = [
  'move-in-cleaning',
  'air-conditioner-cleaning',
  'studio-moving',
  'full-service-moving',
  'leak-detection',
  'wallpaper-flooring'
];
const recommendedServices = SERVICES.filter(s => recommendedSlugs.includes(s.slug));

const pageTitle = '바로견적 | 견적 받기 전에, 적정 비용부터 확인하세요';
const pageDescription = '청소·이사·집수리 등 생활서비스의 시장 가격과 추가요금 조건을 간편하게 확인하세요. 30대 필수 생활서비스 실거래 빅데이터 기반 예상 견적 및 바가지 예방 체크리스트 제공.';
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-pill-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>실거래 빅데이터 기반 30개 생활서비스 견적 플랫폼</span>
      </div>

      <h1 class="hero-title">
        집수리·청소·이사 비용<br />
        <span class="highlight">적정 견적부터</span> 확인하세요
      </h1>

      <p class="hero-desc">
        청소·이사·집수리 등 생활서비스의 시장 가격과 추가요금 조건을 투명하게 확인하세요.<br class="pc-br" />
        개인정보 입력 없이 표준 시장 가격표와 현장 바가지 예방 체크리스트를 즉시 비교할 수 있습니다.
      </p>

      <!-- Pill Search Box -->
      <div class="hero-search-wrapper">
        <div class="search-box">
          <svg class="search-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="6" stroke="#0D9488" stroke-width="2"/>
            <path d="M13.5 13.5L17.5 17.5" stroke="#0D9488" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <input
            type="search"
            id="toolSearchInput"
            class="search-input"
            placeholder="어떤 서비스 비용이 궁금하세요? (예: 입주청소, 에어컨 설치, 누수탐지)"
            aria-label="생활서비스 견적 도구 검색"
            autocomplete="off"
          />
        </div>

        <div class="search-keywords" aria-label="인기 검색어">
          <span class="kw-label">인기 서비스:</span>
          <button type="button" class="kw-btn" data-search="입주청소">입주청소</button>
          <button type="button" class="kw-btn" data-search="에어컨 분해청소">에어컨 청소</button>
          <button type="button" class="kw-btn" data-search="원룸이사">원룸이사</button>
          <button type="button" class="kw-btn" data-search="누수탐지">누수탐지</button>
          <button type="button" class="kw-btn" data-search="욕실 리모델링">욕실 리모델링</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Top Ad Slot -->
  <div class="container">
    <AdSlot slotId="home-top-responsive" format="horizontal" />
  </div>

  <!-- Search Results Live Container (Hidden by default) -->
  <section class="search-results-section container" id="searchResultsSection" style="display: none;">
    <div class="section-header-inline">
      <h2 class="section-title">검색 결과 (<span id="searchResultCount">0</span>)</h2>
      <button type="button" class="btn btn-secondary" id="clearSearchBtn">검색 초기화</button>
    </div>
    <div class="services-grid" id="searchResultsGrid">
      <!-- Injected via JavaScript -->
    </div>
  </section>

  <!-- 6 Categories Section -->
  <section class="categories-section container">
    <div class="section-header">
      <h2 class="section-title">6대 생활서비스 카테고리</h2>
      <p class="section-subtitle">원하시는 분야를 선택하면 세부 견적 도구로 바로 이동합니다.</p>
    </div>

    <div class="categories-grid">
      {CATEGORIES.map(category => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>

  <!-- Editorial Recommended Tools -->
  <section class="recommended-section container">
    <div class="section-header">
      <span class="section-tag">가장 많이 찾는 서비스</span>
      <h2 class="section-title">추천 핵심 견적 도구</h2>
      <p class="section-subtitle">이사철, 계절 교체 시기, 인테리어 전 필수 확인 서비스입니다.</p>
    </div>

    <div class="services-grid">
      {recommendedServices.map(service => (
        <ServiceCard service={service} />
      ))}
    </div>
  </section>

  <!-- 3-Step Guide Section -->
  <section class="guide-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">바로견적 3단계 이용안내</h2>
        <p class="section-subtitle">복잡한 절차나 개인정보 유출 없이 1분 만에 시장 적정가를 확인하세요.</p>
      </div>

      <div class="guide-grid">
        <div class="guide-card">
          <div class="guide-num">01</div>
          <h3 class="guide-title">서비스 선택</h3>
          <p class="guide-desc">
            청소, 이사, 냉난방, 누수, 인테리어, 생활설치 등 총 30가지 생활서비스 중 필요한 항목을 선택합니다.
          </p>
        </div>

        <div class="guide-card">
          <div class="guide-num">02</div>
          <h3 class="guide-title">조건 선택</h3>
          <p class="guide-desc">
            평수, 작업 범위, 특수 장비, 자재 등 견적에 영향을 주는 핵심 변수를 클릭으로 가볍게 선택합니다.
          </p>
        </div>

        <div class="guide-card">
          <div class="guide-num">03</div>
          <h3 class="guide-title">적정 비용 &amp; 체크리스트 확인</h3>
          <p class="guide-desc">
            실거래 빅데이터 기반 예상 범위와 현장 추가요금 주의사항, 업체 상담 시 핵심 질문을 확인합니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mid Ad Slot -->
  <div class="container">
    <AdSlot slotId="home-mid-banner" format="horizontal" />
  </div>

  <!-- All 30 Tools Section -->
  <section class="all-tools-section container" id="all-tools">
    <div class="section-header">
      <span class="section-tag">전체 디렉터리</span>
      <h2 class="section-title">30개 생활서비스 전체 견적 도구</h2>
      <p class="section-subtitle">누락 없이 모든 생활서비스의 정량 산정 규칙과 현장 체크리스트를 둘러보세요.</p>
    </div>

    <div class="category-grouped-tools">
      {CATEGORIES.map(category => {
        const catServices = getServicesByCategory(category.id);
        return (
          <div class="category-group" id={`cat-group-${category.id}`}>
            <div class="group-header">
              <div class="group-title-box">
                <span class="group-icon">{category.icon}</span>
                <h3 class="group-title">{category.name}</h3>
                <span class="group-count">({catServices.length}개 서비스)</span>
              </div>
              <a href={`/category/${category.id}`} class="group-link">
                카테고리 전체보기 →
              </a>
            </div>

            <div class="services-grid">
              {catServices.map(service => (
                <ServiceCard service={service} />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
    padding: 48px 0 36px;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 20px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-primary);
    border-radius: 50%;
  }

  .hero-title {
    font-size: clamp(1.85rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.025em;
    color: var(--color-text-main);
    margin: 0 0 16px;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .highlight {
    color: var(--color-primary);
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 auto 32px;
    max-width: 640px;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .pc-br {
    display: inline;
  }
  .mobile-br {
    display: none;
  }

  /* Search */
  .hero-search-wrapper {
    max-width: 640px;
    margin: 0 auto;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    background-color: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.06);
    transition: all 0.2s ease;
  }

  .search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
  }

  .search-icon {
    position: absolute;
    left: 18px;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 54px;
    padding: 0 20px 0 50px;
    border: none;
    font-size: 0.95rem;
    color: var(--color-text-main);
    outline: none;
    background: transparent;
    border-radius: var(--radius-full);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .search-keywords {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    font-size: 0.82rem;
  }

  .kw-label {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .kw-btn {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 4px 12px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-body);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .kw-btn:hover {
    background-color: var(--color-primary-light);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .section-header-inline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 8px;
  }

  .section-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .section-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Grids */
  .categories-section {
    padding: 44px 0 24px;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 16px;
  }

  .recommended-section {
    padding: 40px 0 24px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  /* 3-Step Guide */
  .guide-section {
    background-color: #ffffff;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 48px 0;
    margin: 36px 0;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .guide-card {
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 24px;
  }

  .guide-num {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-primary);
    margin-bottom: 10px;
    font-variant-numeric: tabular-nums;
  }

  .guide-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--color-text-main);
  }

  .guide-desc {
    font-size: 0.885rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* All Tools Grouped */
  .all-tools-section {
    padding: 36px 0 60px;
  }

  .category-grouped-tools {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .category-group {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 28px;
  }

  .group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border);
  }

  .group-title-box {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .group-icon {
    font-size: 22px;
  }

  .group-title {
    font-size: 1.25rem;
    font-weight: 750;
    margin: 0;
    color: var(--color-text-main);
  }

  .group-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .group-link {
    font-size: 0.885rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .group-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 36px 0 28px;
    }

    .pc-br {
      display: none;
    }
    .mobile-br {
      display: inline;
    }

    .search-input {
      height: 48px;
      font-size: 0.9rem;
    }

    .guide-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .categories-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .category-group {
      padding: 18px;
    }
  }
</style>

<script>
  // Instant Search Logic across all 30 tools
  const searchInput = document.getElementById('toolSearchInput') as HTMLInputElement | null;
  const tagBtns = document.querySelectorAll('.kw-btn');
  const searchResultsSection = document.getElementById('searchResultsSection');
  const searchResultsGrid = document.getElementById('searchResultsGrid');
  const searchResultCount = document.getElementById('searchResultCount');
  const clearSearchBtn = document.getElementById('clearSearchBtn');
  const allServiceCards = document.querySelectorAll('.category-group .service-card');

  function performSearch(query: string) {
    const q = query.trim().toLowerCase();
    if (!q) {
      if (searchResultsSection) searchResultsSection.style.display = 'none';
      return;
    }

    const matchedCards: Element[] = [];
    allServiceCards.forEach((card) => {
      const text = card.textContent?.toLowerCase() || '';
      if (text.includes(q)) {
        matchedCards.push(card.cloneNode(true) as Element);
      }
    });

    if (searchResultsSection && searchResultsGrid && searchResultCount) {
      searchResultsGrid.innerHTML = '';
      if (matchedCards.length > 0) {
        matchedCards.forEach((card) => searchResultsGrid.appendChild(card));
      } else {
        searchResultsGrid.innerHTML = `<div class="p-6 text-center text-muted" style="grid-column: 1/-1; padding: 32px; text-align: center; color: var(--color-text-muted);">'${query}'에 해당하는 견적 도구를 찾을 수 없습니다.</div>`;
      }
      searchResultCount.textContent = String(matchedCards.length);
      searchResultsSection.style.display = 'block';
      searchResultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      performSearch((e.target as HTMLInputElement).value);
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const keyword = btn.getAttribute('data-search') || '';
        searchInput.value = keyword;
        performSearch(keyword);
      });
    });
  }

  if (clearSearchBtn && searchInput) {
    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      if (searchResultsSection) searchResultsSection.style.display = 'none';
    });
  }
</script>
